# Host folder where the normal Docker instance saves nightly SQLite backups.
# Use forward slashes on Windows Docker Desktop.
#
# Linux example:
# M3U_BACKUP_DIR=/home/me/Documents/m3u_picker/nightly
#
# macOS example:
# M3U_BACKUP_DIR=/Users/me/Documents/m3u_picker/nightly
#
# Windows Docker Desktop example:
# M3U_BACKUP_DIR=C:/Users/me/Documents/m3u_picker/nightly

M3U_BACKUP_DIR=./backups
M3U_HOST_PORT=9999

# Provider import safeguards. Defaults are suitable for normal live-TV catalogs.
M3U_MAX_PROVIDER_CHANNELS=50000
M3U_PROVIDER_CHANNEL_WARNING=20000
M3U_MAX_PROVIDER_PLAYLIST_BYTES=100663296
M3U_MAX_PROVIDER_JSON_BYTES=100663296
