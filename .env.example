# Bare host-Python runtime defaults.

M3U_PORT=9999
M3U_EXTERNAL_PORT=9999
M3U_DATA_DIR=./data
M3U_CAST_HLS_DIR=./data/cast-hls
M3U_BACKUP_CONTAINER_DIR=./backups

# Optional absolute path to ffmpeg. Leave blank when ffmpeg is already on PATH.
M3U_FFMPEG=

# Set to the host computer's private IPv4 address for Roku/Cast/HDHomeRun
# LAN discovery/playback, for example 192.168.1.25.
M3U_LAN_HOST=

M3U_ONBOARDING_ENABLED=true
M3U_BACKUP_ENABLED=true
M3U_MAX_PROVIDER_CHANNELS=50000
M3U_PROVIDER_CHANNEL_WARNING=20000
M3U_MAX_PROVIDER_PLAYLIST_BYTES=100663296
M3U_MAX_PROVIDER_JSON_BYTES=100663296
M3U_MAX_PUBLIC_EPG_COMPRESSED_BYTES=268435456
BACKUP_RETENTION_DAYS=30
MASTER_REFRESH_HOUR=3
MASTER_REFRESH_MINUTE=0
