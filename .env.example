# v30-experiments has a fixed host port of 1000 in docker-compose.yml and uses
# ./debug-data for disposable state. Main's Docker volume/backups are untouched.

M3U_MAX_PROVIDER_CHANNELS=50000
M3U_PROVIDER_CHANNEL_WARNING=20000
M3U_MAX_PROVIDER_PLAYLIST_BYTES=100663296
M3U_MAX_PROVIDER_JSON_BYTES=100663296

# LAN address advertised to Cast, Roku, and the HDHomeRun HTTP endpoints.
M3U_LAN_HOST=10.0.0.22
M3U_EXTERNAL_PORT=1000

# Experimental HDHomeRun compatibility endpoint. 10500009 passes SiliconDust's
# published device-ID self-check. DeviceAuth stays empty unless you have a
# legitimate value; this project never fabricates one.
M3U_HDHR_DEVICE_ID=10500009
M3U_HDHR_TUNER_COUNT=4
M3U_HDHR_FRIENDLY_NAME=HDHomeRun CONNECT
M3U_HDHR_MODEL_NUMBER=HDHR5-4US
M3U_HDHR_DEVICE_AUTH=
