# Experimental -dev Docker stack defaults.
# Copy to .env or export values in your shell before `docker compose up`.

M3U_HOST_PORT=9998
M3U_EXTERNAL_PORT=9998
M3U_LAN_HOST=10.0.0.22
M3U_BACKUP_DIR=./data/backups-dev
# Optional. Set this to the exact host Jellyfin cache directory if you want the
# first-run wizard to enable automatic post-update cache cleanup.
M3U_JELLYFIN_CACHE_DIR=
M3U_MAX_PROVIDER_CHANNELS=50000
M3U_PROVIDER_CHANNEL_WARNING=20000
M3U_MAX_PROVIDER_PLAYLIST_BYTES=100663296
M3U_MAX_PROVIDER_JSON_BYTES=100663296
M3U_MAX_PUBLIC_EPG_COMPRESSED_BYTES=268435456
