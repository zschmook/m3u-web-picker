# Normal main-stack defaults. Copy to `.env` and override only what you need.

M3U_HOST_PORT=9999
M3U_EXTERNAL_PORT=9999
# Optional: override data directory location when not using container bind volume.
M3U_DATA_DIR=./data
# Set this to the host computer's private IPv4 address for Roku/Cast/HDHomeRun
# LAN discovery/playback, for example 192.168.1.25. On macOS/Linux source
# installs, `./scripts/detect-lan-host.sh --write-env` can populate it.
M3U_LAN_HOST=
M3U_BACKUP_DIR=./runtime/backups
# Host folder for DVR captures and completed recordings. Use an absolute path
# when recordings should live outside this repository.
M3U_DVR_DIR=./runtime/recordings
# `auto` prefers NVENC when GPU passthrough is active; set `cpu` to force libx265.
M3U_DVR_HEVC_ENCODER=auto
# Optional Jellyfin cache mount. Leave blank when not using cache cleanup.
M3U_JELLYFIN_CACHE_DIR=
M3U_MAX_PROVIDER_CHANNELS=50000
M3U_PROVIDER_CHANNEL_WARNING=20000
M3U_MAX_PROVIDER_PLAYLIST_BYTES=100663296
M3U_MAX_PROVIDER_JSON_BYTES=100663296
M3U_MAX_PUBLIC_EPG_COMPRESSED_BYTES=268435456

# Optional isolated wizard-test overrides used by docker-compose.dev.yml.
M3U_DEV_HOST_PORT=9998
M3U_DEV_EXTERNAL_PORT=9998
M3U_DEV_BACKUP_DIR=./runtime/backups-dev
