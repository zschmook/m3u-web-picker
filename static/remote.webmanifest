    "client_mode": "focus-existing"
  },
  "background_color": "#070b12",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "/static/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
